{
  "name": "dx7-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The DX7 editor app.",
  "scripts": {
    "dev": "pnpm engine && pnpm relay && next dev",
    "build": "pnpm engine && pnpm relay && next build",
    "start": "next start",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "pnpm relay && tsc --noEmit",
    "relay": "node scripts/relay.ts",
    "schema:pull": "node scripts/fetch-api-schema.ts",
    "engine": "pnpm -F @dblodorn/yamaha-dx7-engine build:worklet"
  },
  "dependencies": {
    "@dblodorn/yamaha-dx7-engine": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "motion": "14.3.0",
    "next": "^15.5.7",
    "obscenity": "0.4.5",
    "radix-ui": "^1.8.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "esbuild": "0.25.12",
    "get-graphql-schema": "^2.1.2",
    "postcss": "^8.5.32",
    "relay-compiler": "^21.0.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9.3"
  }
}
